{
  "name": "thebes-poll-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-sdk": "node -e \"const fs=require('node:fs');fs.mkdirSync('public',{recursive:true});for(const f of ['boundary.js'])fs.copyFileSync('node_modules/@thebes/sdk/runtime/'+f,'public/'+f)\"",
    "dev": "npm run sync-sdk && vite",
    "build": "npm run sync-sdk && tsc && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "@thebes/sdk": "github:Mercatura-Forum/thebes-sdk#v0.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
